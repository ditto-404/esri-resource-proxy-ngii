<?xml version="1.0" encoding="utf-8" ?>
<ProxyConfig allowedReferers="*"
             logFile="proxy_log.log"
             logLevel="SEVERE"
             mustMatch="true">

    <serverUrls>

        <serverUrl
            url="https://map.ngii.go.kr/openapi/"
            matchAll="true"/>

    </serverUrls>

</ProxyConfig>

<!-- See https://github.com/Esri/resource-proxy for more information -->
